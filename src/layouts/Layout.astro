---
import '@fontsource/poppins';
import '@fontsource/poppins/500.css';
import '@fontsource/allerta-stencil';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  metaDescription?: string;
  ogTitle?: string;
  canonical?: string;
}

const { title, metaDescription, ogTitle, canonical } = Astro.props;
---

<!doctype html>
<html lang='sr'>
  <head>
    <title>{title}</title>

    <!-- META -->
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='color-scheme' content='dark' />
    <meta name='theme-color' content='#050403' />
    <meta name='title' content={title} />
    <meta name='description' content={metaDescription} />

    <!-- OG -->
    <meta property='og:site_name' content='Lass Projekt' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:image' content=`${canonical}/og-lp.jpeg` />
    <meta property='og:image' content=`${canonical}/og-lp.jpeg` />
    <meta property='og:title' content={ogTitle} />
    <meta property='og:description' content={metaDescription} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical} />

    <!-- FAVICON -->
    <link rel='icon' type='image/png' href='/favicon/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon/favicon.svg' />
    <link rel='shortcut icon' href='/favicon/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
    <meta name='apple-mobile-web-app-title' content='Lass Projekt' />

    <link rel='canonical' href={canonical} />
  </head>
  <body>
    <Header />
    <main id='main'>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg);
    color: var(--text-body);
    font-family: 'Poppins', sans-serif;
    font-style: normal;
  }
  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  section {
    overflow-x: clip; /* clip, ne hidden: ne pravi scroll kontejner */
    scroll-margin-top: var(--space-500);
  }
  section.padding-bottom {
    scroll-margin-top: var(--space-800);
  }

  :root {
    /* ---------- Boje (tamna tema; skala teksta je obrnuta: 900 = najjači kontrast) ---------- */
    --bg: #050403;
    --bg-raised: #0c0906;
    --bg-elevated: #15100a;

    --gold: #ffd27a;
    --amber: #ff9a1f;
    --ember: #ff5a14;
    --primary: var(--amber);

    --text-header: var(--text-900);
    --text-body: var(--text-700);

    --text-50: hsl(33, 20%, 6%);
    --text-100: hsl(33, 20%, 9%);
    --text-200: hsl(33, 18%, 14%);
    --text-300: hsl(33, 16%, 22%);
    --text-400: hsl(33, 14%, 32%);
    --text-500: hsl(33, 14%, 44%);
    --text-600: hsl(33, 14%, 54%);
    --text-700: hsl(33, 15%, 63%);
    --text-800: hsl(35, 25%, 80%);
    --text-900: hsl(37, 45%, 94%);

    --line: rgba(255, 190, 100, 0.14);
    --line-strong: rgba(255, 190, 100, 0.34);

    --gradient-brand: linear-gradient(105deg, var(--gold), var(--amber) 52%, var(--ember));
    --gradient-heading: linear-gradient(100deg, #fff4dc 0%, var(--gold) 38%, var(--amber) 78%, var(--ember) 115%);

    /* ---------- Fontovi ---------- */
    --ff-heading: 'Allerta Stencil', system-ui, sans-serif;
    --ff-body: 'Poppins', system-ui, sans-serif;

    /* ---------- Responsive font sizes ---------- */
    --fs-100: clamp(0.75rem, 2vw + 0.25rem, 0.875rem); /* + rem is for users zooming */
    --fs-200: clamp(0.875rem, 2.5vw + 0.5rem, 1rem);
    --fs-300: clamp(1rem, 2.75vw + 0.65rem, 1.125rem);
    --fs-400: clamp(1.125rem, 3vw + 0.5rem, 1.25rem);
    --fs-500: clamp(1.375rem, 4vw + 0.75rem, 1.75rem);
    --fs-600: clamp(1.75rem, 5vw + 0.75rem, 2.5rem);
    --fs-700: clamp(2.25rem, 7vw + 0.75rem, 3.5rem);
    --fs-800: clamp(2.75rem, 8.5vw + 0.75rem, 4.25rem);
    --fs-900: clamp(3rem, 10vw + 1rem, 5rem);
    --fs-display: clamp(2.6rem, 8.6vw, 8rem); /* hero naslov */

    /* ---------- Spacing/Padding Scale ---------- */
    --space-100: clamp(0.25rem, 0.5vw, 0.5rem);
    --space-200: clamp(0.5rem, 1vw, 0.75rem);
    --space-300: clamp(0.75rem, 1.5vw, 1rem);
    --space-400: clamp(1rem, 2vw, 1.5rem);
    --space-500: clamp(1.5rem, 3vw, 2rem);
    --space-600: clamp(2rem, 4vw, 3rem);
    --space-700: clamp(3rem, 6vw, 4rem);
    --space-800: clamp(4rem, 8vw, 6rem);

    /* ---------- Section Spacing ---------- */
    --section-spacing-sm: clamp(0.75rem, 2vw, 1rem);
    --section-spacing-md: clamp(2rem, 4vw, 4rem);
    --section-spacing-lg: clamp(4rem, 8vw, 7.5rem);
    --section-spacing-xl: clamp(6rem, 12vw, 12rem);
    --section-spacing-xxl: clamp(8rem, 16vw, 16rem);
    --section-spacing-xxxl: clamp(10rem, 18vw, 18rem);

    /* Should be modified per project */
    --x-spacing-desktop: var(--section-spacing-lg);
    --x-spacing-tablet: var(--section-spacing-md);
    --x-spacing-mobile: var(--space-400);

    --y-spacing-desktop: var(--section-spacing-lg);
    --y-spacing-tablet: var(--section-spacing-md);
    --y-spacing-mobile: var(--section-spacing-md);

    --section-spacing-full-desktop: var(--y-spacing-desktop) var(--x-spacing-desktop);
    --section-spacing-full-tablet: var(--y-spacing-tablet) var(--x-spacing-tablet);
    --section-spacing-full-mobile: var(--y-spacing-mobile) var(--x-spacing-mobile);
    --section-spacing-top-desktop: var(--section-spacing-lg) var(--x-spacing-desktop) 0 var(--x-spacing-desktop);
    --section-spacing-top-tablet: var(--section-spacing-md) var(--x-spacing-tablet) 0 var(--x-spacing-tablet);
    --section-spacing-top-mobile: var(--section-spacing-sm) var(--x-spacing-mobile) 0 var(--x-spacing-mobile);
    --section-spacing-bottom-desktop: 0 var(--x-spacing-desktop) var(--section-spacing-lg) var(--x-spacing-desktop);
    --section-spacing-bottom-tablet: 0 var(--x-spacing-tablet) var(--section-spacing-md) var(--x-spacing-tablet);
    --section-spacing-bottom-mobile: 0 var(--x-spacing-mobile) var(--section-spacing-sm) var(--x-spacing-mobile);

    /* Skraćenice: sekcije samo napišu padding: var(--section-padding), a breakpoint se menja ovde */
    --section-padding: var(--section-spacing-full-desktop);
    --x-pad: var(--x-spacing-desktop);

    --container-spacing: clamp(1rem, 3vw, 2rem); /* Consistent edge spacing */

    /* ---------- Border Radius ---------- */
    --rounded-xsm: 0.125rem;
    --rounded-sm: 0.25rem;
    --rounded-md: 0.375rem;
    --rounded-lg: 0.5rem;
    --rounded-xl: 0.75rem;
    --rounded-2xl: 1rem;
    --rounded-3xl: 1.5rem;
    --rounded-full: 9999px;

    --ease: cubic-bezier(0.16, 1, 0.3, 1);

    font-family: var(--ff-body);
    font-feature-settings:
      'liga' 1,
      'calt' 1; /* fix for Chrome */
    color-scheme: dark;
  }

  @media (max-width: 1024px) {
    :root {
      --section-padding: var(--section-spacing-full-tablet);
      --x-pad: var(--x-spacing-tablet);
    }
  }
  @media (max-width: 768px) {
    :root {
      --section-padding: var(--section-spacing-full-mobile);
      --x-pad: var(--x-spacing-mobile);
    }
  }
  h1,
  h2,
  h3 {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    font-family: var(--ff-heading);
    line-height: 1.15;
    letter-spacing: -0.025em;
    background-image: var(--gradient-heading);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 {
    font-size: var(--fs-800);
    font-weight: 800;
    margin-bottom: 24px;
  }
  h2 {
    font-size: var(--fs-600);
    font-weight: 700;
  }
  h3 {
    font-size: var(--fs-400);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  @media (forced-colors: active) {
    h1,
    h2,
    h3 {
      color: CanvasText;
      background-image: none;
    }
  }

  p {
    margin: 0;
    font-size: var(--fs-200);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    h1 {
      margin-bottom: 16px;
    }
  }
</style>