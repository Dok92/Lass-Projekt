---
/**
 * BoxViewer — 3D kutija (three.js) u stilu #kutija sekcije.
 * Sam sadrži "stage" izgled (okvir, gradijent, registarske oznake), pa se u sekciji koristi direktno:
 *   <section class='box-sec' id='kutija'><BoxViewer /></section>
 * Three.js i model se učitavaju tek kad se sekcija približi ekranu.
 */

/**
 * Lista kutija za padajući meni. Za novu kutiju dodajte red:
 *   { id: 'jedinstveni-id', name: 'Naziv u meniju', model: '/putanja/do/modela.glb' }
 * Prva u nizu je izabrana pri učitavanju. Svaki model treba da ima animaciju otvaranja/zatvaranja (slajder).
 */
const boxes = [{ id: 'transportna-americka', name: 'Transportna američka kutija', model: '/box.glb' }];
---

<div class='box-viewer' data-box-viewer>
  <canvas class='box-canvas' role='img' aria-label='3D prikaz kutije. Prevucite za rotaciju.'></canvas>

  <p class='box-hint' aria-hidden='true'>Prevucite za rotaciju</p>
  <div class='box-loader' aria-hidden='true'><i></i></div>

  <div class='box-select' data-box-select>
    <button
      type='button'
      class='box-select-btn'
      aria-haspopup='listbox'
      aria-expanded='false'
      aria-controls='box-select-list'
      aria-labelledby='box-select-label box-select-value'
    >
      <span class='box-select-label' id='box-select-label'>Kutija</span>
      <span class='box-select-value' id='box-select-value'>{boxes[0].name}</span>
      <svg class='box-select-chevron' viewBox='0 0 12 8' width='12' height='8' aria-hidden='true' focusable='false'>
        <path d='M1 1.5l5 5 5-5' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='square' />
      </svg>
    </button>
    <ul class='box-select-list' id='box-select-list' role='listbox' tabindex='-1' aria-labelledby='box-select-label'>
      {boxes.map((b, i) => (
        <li role='option' id={`box-opt-${b.id}`} data-url={b.model} aria-selected={i === 0 ? 'true' : 'false'}>
          {b.name}
        </li>
      ))}
    </ul>
  </div>
  <p class='box-error' role='status'>3D prikaz trenutno nije dostupan.</p>

  <p class='box-zoom-hint' aria-hidden='true'>Ctrl / ⌘ + točkić za zum</p>

  <div class='box-zoom' role='group' aria-label='Zum kutije'>
    <button type='button' class='box-zoom-btn' data-zoom='in' aria-label='Uvećaj'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M8 3v10M3 8h10' /></svg>
    </button>
    <button type='button' class='box-zoom-btn' data-zoom='out' aria-label='Umanji'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M3 8h10' /></svg>
    </button>
    <button type='button' class='box-zoom-btn' data-zoom='reset' aria-label='Vrati početni prikaz'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4' /></svg>
    </button>
  </div>

  <div class='box-controls'>
    <input
      id='box-animation'
      class='box-slider'
      type='range'
      min='0'
      max='1'
      step='0.001'
      value='0'
      aria-label='Otvaranje i zatvaranje kutije'
    />
    <div class='box-slider-labels' aria-hidden='true'>
      <span>Otvorena</span>
      <span>Zatvorena</span>
    </div>
  </div>
</div>

<script>
  const MODEL_URL = '/box.glb';
  // 'ctrl'   = točkić zumira samo uz Ctrl/⌘ (i pinch na touchpadu), inače se skroluje stranica
  // 'always' = točkić uvek zumira (ali "hvata" skrol stranice dok je kursor na kutiji)
  const WHEEL_ZOOM: 'ctrl' | 'always' = 'ctrl';
  const ZOOM_STEP = 0.8; // svaki klik na + množi razdaljinu kamere sa 0.8 (na - deli)

  const container = document.querySelector<HTMLElement>('[data-box-viewer]');
  const canvas = container?.querySelector<HTMLCanvasElement>('.box-canvas');
  const slider = container?.querySelector<HTMLInputElement>('.box-slider');

  if (!container || !canvas || !slider) throw new Error('BoxViewer: required elements not found.');

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Padajući meni za izbor kutije (listbox, tastatura + miš) ---------- */
  const selectRoot = container.querySelector<HTMLElement>('[data-box-select]')!;
  const selectBtn = selectRoot.querySelector<HTMLButtonElement>('.box-select-btn')!;
  const selectValue = selectRoot.querySelector<HTMLElement>('.box-select-value')!;
  const selectList = selectRoot.querySelector<HTMLElement>('.box-select-list')!;
  const options = Array.from(selectList.querySelectorAll<HTMLElement>('[role="option"]'));

  let currentUrl = options[0].dataset.url!;
  let selectedIndex = 0;
  let activeIndex = 0;
  let onModelChange: ((url: string) => void) | null = null;

  const setActive = (i: number) => {
    activeIndex = (i + options.length) % options.length;
    options.forEach((o, n) => o.classList.toggle('is-active', n === activeIndex));
    selectList.setAttribute('aria-activedescendant', options[activeIndex].id);
    options[activeIndex].scrollIntoView({ block: 'nearest' });
  };
  const markSelected = (i: number) => {
    selectedIndex = i;
    options.forEach((o, n) => o.setAttribute('aria-selected', String(n === i)));
    selectValue.textContent = options[i].textContent!.trim();
  };

  const onOutside = (e: PointerEvent) => {
    if (!selectRoot.contains(e.target as Node)) closeSelect(false);
  };
  function openSelect() {
    selectRoot.classList.add('is-open');
    selectBtn.setAttribute('aria-expanded', 'true');
    setActive(selectedIndex);
    selectList.focus({ preventScroll: true });
    document.addEventListener('pointerdown', onOutside);
  }
  function closeSelect(refocus: boolean) {
    selectRoot.classList.remove('is-open');
    selectBtn.setAttribute('aria-expanded', 'false');
    document.removeEventListener('pointerdown', onOutside);
    if (refocus) selectBtn.focus({ preventScroll: true });
  }
  function choose(i: number) {
    closeSelect(true);
    if (i === selectedIndex) return;
    markSelected(i);
    currentUrl = options[i].dataset.url!;
    onModelChange?.(currentUrl);
  }
  /** Vraća izbor na model koji je stvarno na sceni (ako učitavanje novog ne uspe) */
  const revertSelection = (url: string) => {
    const i = options.findIndex((o) => o.dataset.url === url);
    if (i >= 0) markSelected(i);
    currentUrl = url;
  };

  selectBtn.addEventListener('click', () => (selectRoot.classList.contains('is-open') ? closeSelect(false) : openSelect()));
  selectBtn.addEventListener('keydown', (e) => {
    if (['ArrowDown', 'ArrowUp'].includes(e.key)) {
      e.preventDefault();
      openSelect();
    }
  });
  selectList.addEventListener('keydown', (e) => {
    switch (e.key) {
      case 'ArrowDown': e.preventDefault(); setActive(activeIndex + 1); break;
      case 'ArrowUp': e.preventDefault(); setActive(activeIndex - 1); break;
      case 'Home': e.preventDefault(); setActive(0); break;
      case 'End': e.preventDefault(); setActive(options.length - 1); break;
      case 'Enter':
      case ' ': e.preventDefault(); choose(activeIndex); break;
      case 'Escape': e.preventDefault(); closeSelect(true); break;
      case 'Tab': closeSelect(false); break;
    }
  });
  options.forEach((o, n) => {
    o.addEventListener('pointerover', () => setActive(n));
    o.addEventListener('click', () => choose(n));
  });

  /* ---------- Slajder: radi odmah, i pre nego što se učita 3D ---------- */
  let progress = slider.valueAsNumber || 0;
  let applyProgress: (() => void) | null = null;

  const paintTrack = () => {
    slider.style.setProperty('--p', String(progress));
    slider.setAttribute('aria-valuetext', progress < 0.02 ? 'Otvorena' : progress > 0.98 ? 'Zatvorena' : `Zatvorena ${Math.round(progress * 100)}%`);
  };
  slider.addEventListener('input', () => {
    progress = slider.valueAsNumber;
    paintTrack();
    applyProgress?.();
  });
  paintTrack();

  /* ---------- Renderovanje po potrebi: nema petlje dok se ništa ne menja ---------- */
  let visible = false;
  let started = false;
  let invalidate: () => void = () => {};
  let zoomBy: ((factor: number) => void) | null = null;
  let zoomReset: (() => void) | null = null;

  async function init() {
    try {
      const [THREE, { GLTFLoader }, { OrbitControls }] = await Promise.all([
        import('three'),
        import('three/addons/loaders/GLTFLoader.js'),
        import('three/addons/controls/OrbitControls.js'),
      ]);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, 1, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({
        canvas: canvas!,
        antialias: true,
        alpha: true, // pozadinu daje CSS (isti gradijent kao ostatak sajta)
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      scene.add(new THREE.HemisphereLight(0xfff8ee, 0x5c4d3c, 2.5));

      const keyLight = new THREE.DirectionalLight(0xfff1dc, 3.8);
      keyLight.castShadow = true;
      keyLight.shadow.mapSize.set(1024, 1024);
      keyLight.shadow.bias = -0.0004;
      keyLight.shadow.normalBias = 0.02;
      scene.add(keyLight);

      const fillLight = new THREE.DirectionalLight(0xffbd69, 2.0);
      scene.add(fillLight);

      const rimLight = new THREE.DirectionalLight(0xff8c42, 2.6);
      scene.add(rimLight);

      const ground = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), new THREE.ShadowMaterial({ opacity: 0.5 }));
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = !reduceMotion;
      controls.dampingFactor = 0.08;
      controls.enablePan = false;
      controls.enableZoom = true; // točkić/pinch; točkić se po potrebi filtrira ispod
      controls.minPolarAngle = THREE.MathUtils.degToRad(10);
      controls.maxPolarAngle = THREE.MathUtils.degToRad(85);
      // jedan prst vertikalno skroluje stranicu, horizontalno rotira kutiju
      canvas!.style.touchAction = 'pan-y';

      /* ---------- Frame scheduler ---------- */
      let raf = 0;
      /* ---------- Zum dugmad: glatko pomeranje kamere ka cilju (uklapa se u render po potrebi) ---------- */
      let zoomGoal: number | null = null;
      let homeDistance = 1;
      const camDistance = () => camera.position.distanceTo(controls.target);
      const setCamDistance = (d: number) => {
        const dir = camera.position.clone().sub(controls.target).normalize();
        camera.position.copy(controls.target).addScaledVector(dir, d);
      };

      const frame = () => {
        raf = 0;
        if (!visible) return;
        if (zoomGoal !== null) {
          const d = camDistance();
          const diff = zoomGoal - d;
          if (Math.abs(diff) < d * 0.002) {
            setCamDistance(zoomGoal);
            zoomGoal = null;
          } else {
            setCamDistance(d + diff * 0.2);
            invalidate();
          }
        }
        controls.update(); // šalje 'change' (pa i sledeći frame) samo dok ima kretanja/prigušenja
        renderer.render(scene, camera);
      };
      invalidate = () => {
        if (!raf && visible) raf = requestAnimationFrame(frame);
      };
      controls.addEventListener('change', invalidate);
      controls.addEventListener('start', () => container!.classList.add('is-touched'), { once: true });
      controls.addEventListener('start', () => (zoomGoal = null)); // korisnik preuzima kontrolu

      zoomBy = (factor) => {
        const base = zoomGoal ?? camDistance();
        zoomGoal = THREE.MathUtils.clamp(base * factor, controls.minDistance, controls.maxDistance);
        invalidate();
      };
      zoomReset = () => {
        zoomGoal = THREE.MathUtils.clamp(homeDistance, controls.minDistance, controls.maxDistance);
        invalidate();
      };

      /* ---------- Modeli: učitavanje, keš i prebacivanje ---------- */
      interface Entry {
        model: import('three').Object3D;
        mixer: import('three').AnimationMixer | null;
        action: import('three').AnimationAction | null;
        duration: number;
      }
      const loader = new GLTFLoader();
      const cache = new Map<string, Entry>();
      const defaultDir = new THREE.Vector3(0.9, 0.65, 1).normalize();
      let current: Entry | null = null;
      let framed = false;
      let loadToken = 0;
      let shownUrl = currentUrl;

      async function loadEntry(url: string): Promise<Entry> {
        const hit = cache.get(url);
        if (hit) return hit;

        const gltf = await loader.loadAsync(url);
        const model = gltf.scene;

        const box = new THREE.Box3().setFromObject(model);
        model.position.sub(box.getCenter(new THREE.Vector3()));
        model.position.y -= new THREE.Box3().setFromObject(model).min.y;

        model.traverse((o) => {
          if (o instanceof THREE.Mesh) {
            o.castShadow = true;
            o.receiveShadow = true;
          }
        });

        let mixer: Entry['mixer'] = null;
        let action: Entry['action'] = null;
        let duration = 0;
        if (gltf.animations.length > 0) {
          const clip = gltf.animations[0];
          mixer = new THREE.AnimationMixer(model);
          action = mixer.clipAction(clip);
          action.setLoop(THREE.LoopOnce, 1);
          action.clampWhenFinished = true;
          action.play();
          action.paused = true;
          duration = clip.duration;
        }

        const entry: Entry = { model, mixer, action, duration };
        cache.set(url, entry);
        return entry;
      }

      applyProgress = () => {
        const e = current;
        if (!e?.action || !e.mixer) return;
        e.action.paused = false;
        e.mixer.setTime(progress * e.duration);
        e.action.paused = true;
        invalidate();
      };

      /* Razmere se računaju iz modela, ne iz fiksnih brojeva */
      function frameModel(model: Entry['model']) {
        const size = new THREE.Box3().setFromObject(model).getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);
        const distance = maxDim * 2.5;

        keyLight.position.set(4, 6, 5).normalize().multiplyScalar(maxDim * 5);
        fillLight.position.set(-4, 3, 2).normalize().multiplyScalar(maxDim * 5);
        rimLight.position.set(-2, 3, -5).normalize().multiplyScalar(maxDim * 5);

        const s = maxDim * 1.6;
        Object.assign(keyLight.shadow.camera, { left: -s, right: s, top: s, bottom: -s, near: 0.1, far: maxDim * 12 });
        keyLight.shadow.camera.updateProjectionMatrix();

        ground.scale.setScalar(Math.max(maxDim * 0.5, 0.5));
        ground.position.y = -maxDim * 0.002;

        controls.minDistance = distance * 0.5;
        controls.maxDistance = distance * 1.6;
        controls.target.set(0, maxDim * 0.35, 0);

        // pri promeni kutije zadrži ugao posmatranja, a razdaljinu prilagodi novom modelu
        const dir = framed ? camera.position.clone().sub(controls.target).normalize() : defaultDir;
        homeDistance = distance * 1.494;
        camera.position.copy(controls.target).addScaledVector(dir, homeDistance);
        zoomGoal = null;
        controls.update();
        framed = true;
      }

      function show(entry: Entry) {
        if (current) scene.remove(current.model);
        current = entry;
        scene.add(entry.model);
        container!.classList.toggle('no-anim', !entry.action);
        applyProgress?.(); // pozicija slajdera važi i za novu kutiju
        frameModel(entry.model);
        invalidate();
      }

      async function requestModel(url: string) {
        const token = ++loadToken;
        container!.classList.add('is-switching');
        try {
          const entry = await loadEntry(url);
          if (token === loadToken) {
            show(entry);
            shownUrl = url;
          }
        } catch (error) {
          if (!current) throw error; // prvo učitavanje: prikaži poruku o grešci
          console.error('BoxViewer: model load failed', error);
          if (token === loadToken) revertSelection(shownUrl);
        } finally {
          if (token === loadToken) container!.classList.remove('is-switching');
        }
      }

      const initialUrl = currentUrl;
      await requestModel(initialUrl);
      onModelChange = (url) => void requestModel(url);
      if (currentUrl !== initialUrl) void requestModel(currentUrl); // izabrano dok se three.js učitavao

      /* ---------- Veličina ---------- */
      const resize = () => {
        const w = container!.clientWidth;
        const h = container!.clientHeight;
        if (!w || !h) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
        invalidate();
      };
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(container!);
      resize();

      container!.classList.add('is-ready');
      invalidate();

      addEventListener('pagehide', () => {
        cancelAnimationFrame(raf);
        resizeObserver.disconnect();
        controls.dispose();
        renderer.dispose();
      }, { once: true });
    } catch (error) {
      console.error('BoxViewer: init failed', error);
      container!.classList.add('is-error');
    }
  }

  /* ---------- Točkić miša: zum samo uz Ctrl/⌘, da stranica može normalno da se skroluje preko kutije ---------- */
  let zoomHintTimer = 0;
  if (WHEEL_ZOOM === 'ctrl') {
    container.addEventListener(
      'wheel',
      (e) => {
        if (e.target !== canvas || e.ctrlKey || e.metaKey) return; // Ctrl/⌘ i pinch na touchpadu prolaze do OrbitControls
        e.stopPropagation(); // OrbitControls ne vidi događaj, pa ne zove preventDefault i stranica se skroluje
        container.classList.add('show-zoom-hint');
        clearTimeout(zoomHintTimer);
        zoomHintTimer = window.setTimeout(() => container.classList.remove('show-zoom-hint'), 1400);
      },
      { capture: true, passive: true }
    );
  }

  container.querySelector('.box-zoom')!.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('[data-zoom]');
    if (!btn) return;
    const kind = btn.dataset.zoom;
    if (kind === 'in') zoomBy?.(ZOOM_STEP);
    else if (kind === 'out') zoomBy?.(1 / ZOOM_STEP);
    else zoomReset?.();
  });

  /* Učitaj tek kad se sekcija približi ekranu; renderuj samo dok je vidljiva */
  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) return;
      if (!started) {
        started = true;
        init();
      } else {
        invalidate();
      }
    },
    { rootMargin: '400px 0px' }
  ).observe(container);
</script>

<style>
  .box-viewer {
    position: relative;
    isolation: isolate;
    contain: layout paint;
    width: 100%;
    height: min(86svh, 860px);
    min-height: 460px;
    border-radius: calc(var(--rounded-3xl) + 0.5rem);
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 150, 40, 0.1), transparent 60%),
      var(--bg-raised);
  }

  /* registarske oznake u uglovima, kao na štampi */
  .box-viewer::before {
    --c: var(--gold);
    content: '';
    position: absolute;
    inset: 16px;
    z-index: 3;
    pointer-events: none;
    opacity: 0.55;
    background:
      linear-gradient(var(--c), var(--c)) top left / 20px 1px,
      linear-gradient(var(--c), var(--c)) top left / 1px 20px,
      linear-gradient(var(--c), var(--c)) top right / 20px 1px,
      linear-gradient(var(--c), var(--c)) top right / 1px 20px,
      linear-gradient(var(--c), var(--c)) bottom left / 20px 1px,
      linear-gradient(var(--c), var(--c)) bottom left / 1px 20px,
      linear-gradient(var(--c), var(--c)) bottom right / 20px 1px,
      linear-gradient(var(--c), var(--c)) bottom right / 1px 20px;
    background-repeat: no-repeat;
  }

  /* topli žar ispod kutije */
  .box-viewer::after {
    content: '';
    position: absolute;
    inset: auto 8% 0;
    height: 60%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(60% 70% at 50% 100%, rgba(255, 110, 20, 0.2), transparent);
  }

  .box-canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .is-ready .box-canvas {
    opacity: 1;
  }

  /* ---------- Pomoćni elementi ---------- */
  .box-hint {
    position: absolute;
    top: var(--space-500);
    right: var(--space-500);
    z-index: 2;
    font-size: var(--fs-100);
    color: var(--text-600);
    transition: opacity 0.5s ease;
  }
  .is-touched .box-hint,
  .is-error .box-hint {
    opacity: 0;
  }

  .box-loader {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 120px;
    height: 1px;
    translate: -50% 0;
    overflow: hidden;
    background: var(--line-strong);
    transition: opacity 0.4s ease;
  }
  .box-loader i {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: translate3d(-100%, 0, 0);
    animation: box-load 1.4s ease-in-out infinite;
  }
  .is-ready .box-loader,
  .is-error .box-loader {
    opacity: 0;
  }
  @keyframes box-load {
    to {
      transform: translate3d(100%, 0, 0);
    }
  }

  .box-error {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    place-items: center;
    color: var(--text-600);
  }
  .is-error .box-error {
    display: grid;
  }
  .is-error .box-controls {
    display: none;
  }

  /* ---------- Kontrole ---------- */
  .box-controls {
    position: absolute;
    left: 50%;
    bottom: var(--space-500);
    z-index: 2;
    width: min(480px, calc(100% - 2rem));
    transform: translateX(-50%);
    padding: var(--space-400) var(--space-500);
    background: rgba(12, 9, 6, 0.7);
    border: 1px solid var(--line-strong);
    border-radius: var(--rounded-2xl);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Popunjeni deo = gradijent sajta; ostatak = isprekidana linija savijanja */
  .box-slider {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: 22px;
    margin: 0;
    background:
      linear-gradient(90deg, var(--gold), var(--amber) 55%, var(--ember)) left center / calc(10px + (100% - 20px) * var(--p, 0)) 3px no-repeat,
      repeating-linear-gradient(90deg, var(--line-strong) 0 5px, transparent 5px 10px) left center / 100% 1px no-repeat;
    outline: none;
    cursor: pointer;
  }
  .box-slider:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
  }

  /* Klizač sa odsečenim uglom, kao CTA dugme */
  .box-slider::-webkit-slider-runnable-track {
    height: 22px;
    background: transparent;
  }
  .box-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
