---
/**
 * Header: fiksiran, providan na vrhu, "staklo" + zlatna linija pri skrolu,
 * sakriva se pri skrolu naniže i vraća pri skrolu naviše.
 * Desktop (>=1100px): navigacija u isprekidanom "karton" okviru + CTA sa preklopljenim uglom.
 * Mobilni: animirana hamburger ikonica + fullscreen meni koji se otvara kružnim "reveal"-om.
 *
 * Ovde su i <symbol id='logo'> i gradijent #g-gold (uklonjeni iz index.astro).
 */
const { pathname } = Astro.url;
const current = pathname.replace(/\/+$/, '') || '/';

const nav = [
  {
    href: '/proizvodnja-alata-za-kartonsku-ambalazu-i-pet-foliju',
    label: 'Alati za štancanje',
    title: 'Proizvodnja alata za kartonsku ambalažu i pet foliju'
  },
  {
    href: '/usluge-prosecanja-na-stancni',
    label: 'Prosecanje na štancni',
    title: 'Usluge prosecanja na štancni'
  },
  {
    href: '/kasiranje-kartona-i-papira',
    label: 'Kaširanje',
    title: 'Kaširanje kartona i papira',
  },
  {
    href: '/obrada-drveta-na-cnc-masinama',
    label: 'CNC obrada',
    title: 'Obrada drveta na CNC mašinama'
  },
  {
    href: '/galerija',
    label: 'Galerija',
    title: 'Galerija proizvoda i alata'
  }
];
---

<a class='skip-link' href='#main'>Preskoči na sadržaj</a>

<!-- Logo + zajednički gradijent (ranije u index.astro) -->
<svg width='0' height='0' style='position:absolute' aria-hidden='true' focusable='false'>
  <defs>
    <linearGradient id='g-gold' x1='0' y1='0' x2='1' y2='1'>
      <stop offset='0' stop-color='#ffd77a'></stop>
      <stop offset='.55' stop-color='#ff9a1f'></stop>
      <stop offset='1' stop-color='#ff5a14'></stop>
    </linearGradient>
    <symbol id='logo' viewBox='0 0 152.6396 105.33606'>
