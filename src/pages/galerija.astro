---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';

/* ---------- Izvor slika ----------
 * Stavite fotografije u src/assets/gallery/ — učitaće se sve, redom po imenu fajla (1.jpg, 2.jpg, ...).
 * Dok je taj folder prazan, privremeno se koriste slike iz src/assets/img/ da bi se video izgled.
 */
const gallery = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const fallback = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const source = Object.keys(gallery).length ? gallery : fallback;

// Opisi (alt) po imenu fajla. Ono što nije navedeno dobija opšti opis.
const alts: Record<string, string> = {
  'boxes.webp': 'Kartonske kutije različitih dimenzija i tipova',
  'ploce.jpg': 'Složene kartonske ploče',
  'stancanje.webp': 'Kalup za štancanje kutija',
  'sundjer.webp': 'Proizvodi od sunđera za zaštitu pakovanja',
  'cnc.jpg': 'CNC lasersko sečenje drveta',
};

const entries = Object.entries(source).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));

// Veliku verziju za lightbox generišemo u build-u (jedna veličina, webp)
const items = await Promise.all(
  entries.map(async ([path, mod], i) => {
    const file = path.split('/').pop()!;
    const full = await getImage({ src: mod.default, width: 1800, format: 'webp', quality: 80 });
    return {
      src: mod.default,
      w: mod.default.width,
      h: mod.default.height,
      full: full.src,
      alt: alts[file] ?? `Lass Projekt — fotografija ${i + 1}`,
    };
  })
);
---

<Layout
  title='Galerija — Lass Projekt'
  metaDescription='Galerija radova Lass Projekt: kartonske kutije po meri, kartonske ploče, alati za štancanje, proizvodi od sunđera i CNC obrada drveta.'
  ogTitle='Galerija — Lass Projekt'
>
  <section class='gallery'>

    <header class='gallery-head'>
      <div>
        <h1>Galerija</h1>
        <p>Izbor naših radova: kutije, ploče, alati za štancanje, sunđer i obrada drveta.</p>
      </div>
      {items.length > 0 && <p class='count'>{items.length} fotografija</p>}
    </header>

    {
      items.length > 0 ? (
        <div class='masonry' data-gallery>
          {items.map((it, i) => (
            <button
              type='button'
              class='tile'
              aria-haspopup='dialog'
              style={`aspect-ratio:${it.w}/${it.h}`}
              data-full={it.full}
              data-alt={it.alt}
            >
              <Image
                src={it.src}
                alt={it.alt}
                widths={[360, 540, 720, 960]}
                sizes='(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw'
                format='webp'
                quality={75}
                loading={i < 4 ? 'eager' : 'lazy'}
                fetchpriority={i < 2 ? 'high' : undefined}
                decoding='async'
              />
            </button>
          ))}
        </div>
      ) : (
        <p class='empty'>Fotografije stižu uskoro.</p>
      )
    }
  </section>

  <!-- Lightbox -->
  <dialog class='lb' aria-label='Pregled fotografije'>
    <div class='lb-stage'>
      <img class='lb-img' alt='' decoding='async' />
    </div>
    <button type='button' class='lb-btn lb-close' aria-label='Zatvori'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M2 2l12 12M14 2L2 14' /></svg>
    </button>
    <button type='button' class='lb-btn lb-prev' aria-label='Prethodna fotografija'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M10 2L4 8l6 6' /></svg>
    </button>
    <button type='button' class='lb-btn lb-next' aria-label='Sledeća fotografija'>
      <svg viewBox='0 0 16 16' width='16' height='16' aria-hidden='true'><path d='M6 2l6 6-6 6' /></svg>
    </button>
    <p class='lb-count' aria-live='polite'></p>
  </dialog>
</Layout>

<style>
  .gallery {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: var(--section-padding);
    margin-top: var(--space-800);
    background: var(--bg);
  }
  .gallery::before {
    /* topli sjaj u uglu, isti jezik kao hero */
    content: '';
    position: absolute;
    top: -20vmax;
    left: -18vmax;
    z-index: -1;
    width: 60vmax;
    height: 60vmax;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 196, 80, 0.14), rgba(255, 196, 80, 0));
  }

  /* ---------- Zaglavlje ---------- */
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-300);
    margin-bottom: var(--space-700);
    animation: gal-fade 0.9s var(--ease) both;
  }
  .back svg {
    width: 48px;
    aspect-ratio: 152.64 / 105.34;
    display: block;
  }
  .back span {
    font: 700 var(--fs-200) / 1 var(--ff-heading);
    color: var(--text-header);
    transition: color 0.25s ease;
  }
  .back:hover span {
    color: var(--gold);
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-400) var(--space-600);
    margin-bottom: var(--space-700);
    padding-bottom: var(--space-500);
    border-bottom: 1px dashed var(--line-strong); /* linija savijanja */
    animation: gal-fade 1s var(--ease) 0.1s both;
  }
  .gallery-head h1 {
    margin-bottom: var(--space-300);
    font-size: var(--fs-display);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .gallery-head p {
    max-width: 34rem;
    font-size: var(--fs-300);
  }
  .gallery-head .count {
    font-size: var(--fs-100);
    letter-spacing: 0.04em;
    color: var(--text-600);
  }

  /* ---------- Masonry: čist CSS (kolone), bez JS merenja ---------- */
  .masonry {
    --gap: var(--space-300);
    columns: 2;
    column-gap: var(--gap);
  }
  @media (min-width: 768px) {
    .masonry {
      columns: 3;
    }
  }
  @media (min-width: 1280px) {
    .masonry {
      columns: 4;
    }
  }

  .tile {
    --fold: 12px;
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 var(--gap);
    padding: 0;
    border: 0;
    overflow: hidden;
    break-inside: avoid;
    background: var(--bg-elevated); /* boja dok se slika učitava */
    cursor: zoom-in;
    /* odsečen gornji desni ugao, kao na CTA dugmetu */
    clip-path: polygon(0 0, calc(100% - var(--fold)) 0, 100% var(--fold), 100% 100%, 0 100%);
    transition: --fold 0.5s var(--ease);
  }
  .tile::after {
    /* naličje preklopljenog ugla */
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: var(--fold);
    height: var(--fold);
    background: linear-gradient(135deg, #fff0c9, #e8861a);
    clip-path: polygon(0 0, 0 100%, 100% 100%);
  }
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
    will-change: transform;
  }
  /* slika ostaje čista: nema prekrivanja, samo blagi zum i otvaranje ugla */
  .tile:hover,
  .tile:focus-visible {
    --fold: 28px;
  }
  .tile:hover img {
    transform: scale(1.04);
  }
  .tile:active {
    --fold: 0px;
    transition-duration: 0.12s;
  }
  .tile:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -4px; /* unutra, jer clip-path odseca spoljašnji outline */
  }

  .empty {
    padding-block: var(--space-800);
    text-align: center;
    color: var(--text-600);
  }

  /* Skrol-vođeno otkrivanje (čist CSS) */
  @supports (animation-timeline: view()) {
    .tile {
      animation: gal-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }
  @keyframes gal-in {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0) scale(0.97);
    }
  }
  @keyframes gal-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
  }

  /* ---------- Lightbox ---------- */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--text-900);
    background: rgba(5, 4, 3, 0.96);
  }
  .lb[open] {
    animation: gal-lb-in 0.35s var(--ease);
  }
  @keyframes gal-lb-in {
    from {
      opacity: 0;
    }
  }
  .lb::before {
    /* registarske oznake u uglovima, kao na sceni sa kutijom */
    --c: var(--gold);
    content: '';
    position: absolute;
    inset: 16px;
    pointer-events: none;
    opacity: 0.4;
    background:
      linear-gradient(var(--c), var(--c)) top left / 20px 1px,
      linear-gradient(var(--c), var(--c)) top left / 1px 20px,
      linear-gradient(var(--c), var(--c)) top right / 20px 1px,
      linear-gradient(var(--c), var(--c)) top right / 1px 20px,
      linear-gradient(var(--c), var(--c)) bottom left / 20px 1px,
      linear-gradient(var(--c), var(--c)) bottom left / 1px 20px,
      linear-gradient(var(--c), var(--c)) bottom right / 20px 1px,
      linear-gradient(var(--c), var(--c)) bottom right / 1px 20px;
    background-repeat: no-repeat;
  }
  .lb-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--space-700) 5rem;
    touch-action: pan-y;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
    user-select: none;
  }
  .lb-img.is-swap {
    opacity: 0;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: var(--text-900);
    cursor: pointer;
    background: rgba(12, 9, 6, 0.7);
    border: 1px solid var(--line-strong);
    border-radius: var(--rounded-lg);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .lb-btn:hover,
  .lb-btn:focus-visible {
    color: var(--gold);
    border-color: var(--gold);
  }
  .lb-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: square;
  }
  .lb-close {
    top: var(--space-500);
    right: var(--space-500);
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    left: var(--space-500);
  }
  .lb-next {
    right: var(--space-500);
  }
  .lb-count {
    position: absolute;
    bottom: var(--space-500);
    left: 50%;
    translate: -50% 0;
    font-size: var(--fs-100);
    letter-spacing: 0.06em;
    color: var(--text-600);
  }

  @media (max-width: 640px) {
    .lb-stage {
      padding: 4.5rem var(--space-300) 5.5rem;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: var(--space-400);
      translate: none;
    }
    .lb-prev {
      left: var(--space-400);
    }
    .lb-next {
      right: var(--space-400);
    }
    .lb-count {
      bottom: calc(var(--space-400) + 16px);
    }
    .lb-close {
      top: var(--space-400);
      right: var(--space-400);
    }
  }

  /* zaključaj skrol stranice dok je lightbox otvoren, bez pomeranja sadržaja */
  :global(html:has(.lb[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  @media (prefers-reduced-motion: reduce) {
    .back,
    .gallery-head,
    .tile,
    .lb[open] {
      animation: none;
    }
    .tile,
    .tile img,
    .lb-img,
    .lb-btn {
      transition: none;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('.lb');

  if (grid && dialog) {
    const tiles = Array.from(grid.querySelectorAll<HTMLButtonElement>('.tile'));
    const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const n = tiles.length;

    let index = 0;
    let token = 0;
    let swiped = false;

    const preload = (i: number) => {
      const t = tiles[(i + n) % n];
      new Image().src = t.dataset.full!; // pregledač ga stavlja u keš
    };

    async function show(i: number) {
      index = (i + n) % n;
      const tile = tiles[index];
      const mine = ++token;

      img.classList.add('is-swap');
      img.src = tile.dataset.full!;
      img.alt = tile.dataset.alt ?? '';
      count.textContent = `${index + 1} / ${n}`;

      try {
        await img.decode(); // prikaži tek kad je slika spremna
      } catch {
        /* nastavi i ako dekodiranje ne uspe */
      }
      if (mine !== token) return; // u međuvremenu je izabrana druga
      img.classList.remove('is-swap');
      if (n > 1) {
        preload(index + 1);
        preload(index - 1);
      }
    }

    // Otvaranje (jedan delegirani listener)
    grid.addEventListener('click', (e) => {
      const tile = (e.target as Element).closest<HTMLButtonElement>('.tile');
      if (!tile) return;
      dialog.showModal();
      show(tiles.indexOf(tile));
    });

    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));

    // Klik na prazan prostor zatvara
    dialog.addEventListener('click', (e) => {
      if (swiped) { swiped = false; return; }
      if ((e.target as Element).closest('.lb-img, .lb-btn, .lb-count')) return;
      dialog.close();
    });

    // Tastatura (Esc zatvara nativno)
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'ArrowLeft') show(index - 1);
    });

    // Swipe na dodir
    let sx = 0, sy = 0;
    stage.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        show(index + (dx < 0 ? 1 : -1));
      }
    });

    // Oslobodi memoriju kad se zatvori
    dialog.addEventListener('close', () => {
      token++;
      img.removeAttribute('src');
      img.classList.remove('is-swap');
    });
  }
</script>